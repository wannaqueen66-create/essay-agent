#!/usr/bin/env bash
set -euo pipefail
INSTALL_DIR="/opt/essay-agent"
if [[ ${EUID} -ne 0 ]]; then
  echo "请使用 sudo esag 或 root 运行" >&2
  exit 1
fi
if [[ ! -r /dev/tty ]]; then
  echo "需要交互式终端，请通过 SSH 登录后运行" >&2
  exit 1
fi
if [[ -f "$INSTALL_DIR/esag_console.py" && -x "$INSTALL_DIR/.venv/bin/python" ]]; then
  cd "$INSTALL_DIR"
  exec "$INSTALL_DIR/.venv/bin/python" "$INSTALL_DIR/esag_console.py" "$@" < /dev/tty
fi
printf '\nessay-agent 终端控制台\n[1] 安装 / 升级旧版控制台（保留数据）\n[0] 退出\n'
read -r -p "请选择操作: " choice < /dev/tty
case "$choice" in
  1)
    tmp_script="$(mktemp /tmp/essay-agent-deploy.XXXXXX.sh)"
    trap 'rm -f "$tmp_script"' EXIT
    curl -fsSL https://raw.githubusercontent.com/wannaqueen66-create/essay-agent/main/deploy.sh -o "$tmp_script"
    bash -n "$tmp_script"
    bash "$tmp_script"
    ;;
  0) exit 0 ;;
  *) echo "无效选择"; exit 1 ;;
esac
